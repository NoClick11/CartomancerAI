# Copie para .env e ajuste se necessario. Usado pelo docker-compose para
# localizar pastas no host e, opcionalmente, para rodar o CLI fora do Docker.

# --- Paths no host (bind mounts) ---
MODELS_DIR=./data/models
DATA_DIR=./data
PROMPTS_DIR=./prompts
COMFYUI_OUTPUT_DIR=./data/comfyui-output

# --- Portas ---
COMFYUI_PORT=8188

# --- Config da aplicacao (usadas se voce rodar o cartomancer fora do Docker) ---
# CARTOMANCER_COMFYUI_URL=http://localhost:8188
# CARTOMANCER_DB_PATH=./data/db/cartomancer.sqlite3
# CARTOMANCER_OUTPUT_DIR=./data/output
